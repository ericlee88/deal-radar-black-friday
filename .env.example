# ============================================================================
# DEAL RADAR — PLUGGABLE PROVIDER CONFIGURATION (.env)
# ============================================================================
# Works out-of-the-box in deterministic Local/Seed mode when keys are blank.
# Set any key below to automatically switch that subsystem to Live Mode.

ENVIRONMENT=local
DATABASE_URL=sqlite:///./deal_radar.db
# For Postgres in Docker/Cloud:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@db:5432/deal_radar

# ----------------------------------------------------------------------------
# 1. LLM Intent Resolver (auto | mock | gemini | openai)
# ----------------------------------------------------------------------------
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ----------------------------------------------------------------------------
# 2. Historical Price & ASIN Discovery (auto | mock | keepa)
# ----------------------------------------------------------------------------
PRICE_PROVIDER=auto
KEEPA_API_KEY=

# ----------------------------------------------------------------------------
# 3. Strike-Price Webhook Notifications (none | discord | slack | telegram | ntfy | generic)
# ----------------------------------------------------------------------------
WEBHOOK_PROVIDER=none
WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Background Poller Schedule
POLL_INTERVAL_MINUTES=30
ENABLE_SCHEDULER=true
